<style id="1h6v0m">

/* PREMIUM DYNAMIC BACKGROUND */

body{
  min-height:100vh;
  overflow:hidden;

  background:
  linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)),
  url('https://images.unsplash.com/photo-1541643600914-78b084683601?q=80&w=1920&auto=format&fit=crop');

  background-size:cover;
  background-position:center;
  background-repeat:no-repeat;

  animation:bgAnimation 18s infinite alternate ease-in-out;
}

/* SMOOTH BACKGROUND ZOOM */

@keyframes bgAnimation{

  0%{
    background-size:100%;
    background-position:center;
    filter:brightness(1);
  }

  50%{
    background-size:110%;
    background-position:top;
    filter:brightness(1.1);
  }

  100%{
    background-size:120%;
    background-position:bottom;
    filter:brightness(1);
  }

}

/* FLOATING LIGHT EFFECT */

body::before{
  content:'';
  position:absolute;

  width:600px;
  height:600px;

  background:radial-gradient(circle,
  rgba(255,215,120,0.22),
  transparent 70%);

  top:-200px;
  left:-150px;

  animation:lightMove 10s infinite alternate ease-in-out;
}

/* SECOND LIGHT */

body::after{
  content:'';
  position:absolute;

  width:500px;
  height:500px;

  background:radial-gradient(circle,
  rgba(255,255,255,0.15),
  transparent 70%);

  bottom:-180px;
  right:-120px;

  animation:lightMove2 12s infinite alternate ease-in-out;
}

/* LIGHT ANIMATION */

@keyframes lightMove{

  0%{
    transform:translate(0,0);
  }

  100%{
    transform:translate(150px,100px);
  }

}

@keyframes lightMove2{

  0%{
    transform:translate(0,0);
  }

  100%{
    transform:translate(-120px,-80px);
  }

}

/* GLASS NAVBAR */

.navbar{
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(12px);

  border-bottom:1px solid rgba(255,255,255,0.1);

  position:relative;
  z-index:2;
}

/* WHITE TEXT */

.logo-text h1,
.menu a,
.icon{
  color:#fff;
}

/* GLASS LOGIN FORM */

.form-box{
  width:380px;

  background:rgba(255,255,255,0.12);
  backdrop-filter:blur(15px);

  border:1px solid rgba(255,255,255,0.2);

  padding:40px;
  border-radius:20px;

  box-shadow:0 10px 30px rgba(0,0,0,0.3);

  position:relative;
  z-index:2;
}

/* FORM TEXT */

.form-box h2,
.input-box label,
.switch-text{
  color:#fff;
}

/* INPUT STYLE */

.input-box input{
  background:rgba(255,255,255,0.12);
  border:1px solid rgba(255,255,255,0.2);

  color:#fff;
}

.input-box input::placeholder{
  color:#ddd;
}

/* BUTTON EFFECT */

.submit-btn{
  background:#fff;
  color:#111;
  font-weight:600;
}

.submit-btn:hover{
  transform:scale(1.03);
}

</style>
