<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CricStat.in — Cricket Intelligence Hub</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,600;0,700;1,300&family=Barlow+Condensed:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<style>
  :root {
    --green:   #00c853;
    --green2:  #69f0ae;
    --dark:    #050d0a;
    --dark2:   #0a1a12;
    --dark3:   #0f2418;
    --card:    #0d1f15;
    --border:  #1a3825;
    --text:    #c8e6c9;
    --muted:   #4a7c59;
    --accent:  #ffca28;
    --red:     #ff5252;
    --white:   #f0fff4;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--dark);
    color:var(--text);
    font-family:'Barlow',sans-serif;
    font-weight:300;
    overflow-x:hidden;
    cursor:default;
  }

  /* ─── SCROLLBAR ─── */
  ::-webkit-scrollbar{width:5px;}
  ::-webkit-scrollbar-track{background:var(--dark2);}
  ::-webkit-scrollbar-thumb{background:var(--green);border-radius:3px;}

  /* ─── NOISE TEXTURE OVERLAY ─── */
  body::before{
    content:'';
    position:fixed;inset:0;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events:none;z-index:0;opacity:.4;
  }

  /* ─── NAV ─── */
  nav{
    position:sticky;top:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:0 2.5rem;
    background:rgba(5,13,10,.92);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
    height:64px;
  }
  .logo{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.9rem;
    letter-spacing:3px;
    color:var(--white);
  }
  .logo span{color:var(--green);}
  .nav-links{display:flex;gap:2rem;list-style:none;}
  .nav-links a{
    color:var(--muted);
    text-decoration:none;
    font-family:'Barlow Condensed',sans-serif;
    font-size:.95rem;
    letter-spacing:1px;
    text-transform:uppercase;
    font-weight:600;
    transition:color .2s;
  }
  .nav-links a:hover,.nav-links a.active{color:var(--green);}
  .nav-right{display:flex;align-items:center;gap:1rem;}
  .live-badge{
    display:flex;align-items:center;gap:.4rem;
    background:rgba(255,82,82,.12);
    border:1px solid rgba(255,82,82,.3);
    border-radius:20px;
    padding:.25rem .75rem;
    font-family:'Barlow Condensed',sans-serif;
    font-size:.8rem;
    color:var(--red);
    letter-spacing:1px;
    font-weight:600;
  }
  .live-dot{
    width:7px;height:7px;
    border-radius:50%;
    background:var(--red);
    animation:pulse 1.2s infinite;
  }
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(.7);}}

  /* ─── HERO ─── */
  .hero{
    position:relative;
    min-height:340px;
    display:flex;align-items:center;
    padding:3rem 2.5rem;
    overflow:hidden;
    border-bottom:1px solid var(--border);
  }
  .hero-bg{
    position:absolute;inset:0;
    background:
      radial-gradient(ellipse 70% 120% at 80% 50%, rgba(0,200,83,.08) 0%, transparent 70%),
      radial-gradient(ellipse 40% 80% at 10% 80%, rgba(0,200,83,.05) 0%, transparent 60%),
      var(--dark2);
  }
  .hero-pitch{
    position:absolute;right:-80px;top:50%;transform:translateY(-50%);
    width:420px;height:420px;
    border-radius:50%;
    border:60px solid rgba(0,200,83,.04);
    box-shadow:0 0 0 20px rgba(0,200,83,.03),0 0 0 40px rgba(0,200,83,.02);
  }
  .hero-content{position:relative;z-index:1;max-width:680px;}
  .hero-tag{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.8rem;letter-spacing:3px;
    text-transform:uppercase;color:var(--green);
    font-weight:600;margin-bottom:.8rem;
    display:flex;align-items:center;gap:.5rem;
  }
  .hero-tag::before{content:'';display:block;width:24px;height:2px;background:var(--green);}
  .hero h1{
    font-family:'Bebas Neue',sans-serif;
    font-size:clamp(2.8rem,6vw,5rem);
    line-height:.95;
    color:var(--white);
    letter-spacing:2px;
    margin-bottom:1.2rem;
  }
  .hero h1 em{color:var(--green);font-style:normal;}
  .hero p{
    font-size:1.05rem;color:var(--muted);
    max-width:480px;line-height:1.7;
    margin-bottom:2rem;
  }
  .hero-stats{display:flex;gap:2.5rem;}
  .hstat{border-left:2px solid var(--green);padding-left:1rem;}
  .hstat-val{
    font-family:'Bebas Neue',sans-serif;
    font-size:2rem;color:var(--white);
    letter-spacing:1px;
  }
  .hstat-lbl{font-size:.75rem;color:var(--muted);letter-spacing:1px;text-transform:uppercase;}

  /* ─── SECTION TABS ─── */
  .tabs-bar{
    display:flex;gap:0;
    border-bottom:1px solid var(--border);
    background:var(--dark2);
    padding:0 2.5rem;
    overflow-x:auto;
  }
  .tab-btn{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.95rem;font-weight:600;
    letter-spacing:1.5px;text-transform:uppercase;
    color:var(--muted);
    background:none;border:none;
    padding:1rem 1.6rem;
    cursor:pointer;
    border-bottom:3px solid transparent;
    transition:all .2s;
    white-space:nowrap;
  }
  .tab-btn:hover{color:var(--text);}
  .tab-btn.active{color:var(--green);border-bottom-color:var(--green);}

  /* ─── MAIN GRID ─── */
  .main{padding:2rem 2.5rem;max-width:1400px;margin:0 auto;}
  .section{display:none;}
  .section.active{display:block;}

  /* ─── CARDS ─── */
  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    padding:1.4rem;
    position:relative;
    overflow:hidden;
    transition:border-color .25s,transform .25s;
  }
  .card:hover{border-color:rgba(0,200,83,.35);transform:translateY(-2px);}
  .card::before{
    content:'';position:absolute;top:0;left:0;right:0;height:2px;
    background:linear-gradient(90deg,transparent,var(--green),transparent);
    opacity:0;transition:opacity .25s;
  }
  .card:hover::before{opacity:1;}
  .card-title{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.75rem;letter-spacing:2px;
    text-transform:uppercase;color:var(--muted);
    margin-bottom:1rem;
    display:flex;align-items:center;justify-content:space-between;
  }

  /* ─── GRID LAYOUTS ─── */
  .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;}
  .grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;}
  .grid-1-2{display:grid;grid-template-columns:1fr 2fr;gap:1.2rem;}
  .grid-2-1{display:grid;grid-template-columns:2fr 1fr;gap:1.2rem;}

  /* ─── LIVE SCORE ─── */
  .live-matches{display:flex;flex-direction:column;gap:1.2rem;}
  .match-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    padding:1.6rem;
    transition:border-color .25s;
  }
  .match-card:hover{border-color:rgba(0,200,83,.3);}
  .match-meta{
    display:flex;align-items:center;gap:.8rem;
    margin-bottom:1.2rem;
  }
  .match-type{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.7rem;letter-spacing:2px;
    text-transform:uppercase;
    background:rgba(0,200,83,.1);
    border:1px solid rgba(0,200,83,.25);
    color:var(--green);
    padding:.2rem .6rem;border-radius:4px;font-weight:600;
  }
  .match-type.test{background:rgba(255,202,40,.08);border-color:rgba(255,202,40,.25);color:var(--accent);}
  .match-type.odi{background:rgba(33,150,243,.08);border-color:rgba(33,150,243,.25);color:#64b5f6;}
  .match-venue{font-size:.8rem;color:var(--muted);}
  .match-status{
    margin-left:auto;
    font-family:'Barlow Condensed',sans-serif;
    font-size:.75rem;letter-spacing:1px;
    color:var(--red);font-weight:600;
  }
  .match-status.completed{color:var(--muted);}
  .scoreboard{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;}
  .team{display:flex;flex-direction:column;}
  .team.away{text-align:right;}
  .team-name{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.5rem;letter-spacing:2px;
    color:var(--white);
  }
  .team-flag{font-size:1.4rem;margin-bottom:.2rem;}
  .score{
    font-family:'Barlow Condensed',sans-serif;
    font-size:2rem;font-weight:700;
    color:var(--green);letter-spacing:1px;
  }
  .overs{font-size:.8rem;color:var(--muted);}
  .vs-divider{text-align:center;}
  .vs{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.2rem;color:var(--muted);
    letter-spacing:2px;
  }
  .crr{font-size:.75rem;color:var(--muted);margin-top:.2rem;}
  .match-note{
    margin-top:1rem;padding-top:1rem;
    border-top:1px solid var(--border);
    font-size:.85rem;color:var(--accent);
    font-family:'Barlow Condensed',sans-serif;
    letter-spacing:.5px;
  }
  .batters-table{
    margin-top:1.2rem;
    width:100%;border-collapse:collapse;
    font-size:.85rem;
  }
  .batters-table th{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.7rem;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--muted);font-weight:600;
    padding:.5rem .8rem;text-align:left;
    border-bottom:1px solid var(--border);
  }
  .batters-table td{
    padding:.55rem .8rem;
    border-bottom:1px solid rgba(26,56,37,.5);
    color:var(--text);
  }
  .batters-table tr:last-child td{border-bottom:none;}
  .batters-table .highlight{color:var(--green);font-weight:600;}
  .batters-table .batting-now::after{
    content:'●';color:var(--green);margin-left:.4rem;font-size:.6rem;
  }

  /* ─── UPCOMING SIDEBAR ─── */
  .upcoming-list{display:flex;flex-direction:column;gap:.8rem;}
  .upcoming-item{
    display:flex;align-items:center;gap:1rem;
    padding:.9rem 1rem;
    background:rgba(255,255,255,.02);
    border:1px solid var(--border);
    border-radius:8px;
    transition:border-color .2s;
  }
  .upcoming-item:hover{border-color:rgba(0,200,83,.25);}
  .udate{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;font-size:1rem;
    color:var(--green);
    min-width:36px;text-align:center;
  }
  .uday{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;}
  .udiv{width:1px;height:36px;background:var(--border);}
  .umatch{font-size:.85rem;color:var(--text);}
  .uvenue{font-size:.72rem;color:var(--muted);margin-top:.15rem;}
  .utype{
    margin-left:auto;
    font-family:'Barlow Condensed',sans-serif;
    font-size:.65rem;letter-spacing:1px;text-transform:uppercase;
    color:var(--muted);
  }

  /* ─── RANKINGS ─── */
  .rank-table{width:100%;border-collapse:collapse;}
  .rank-table th{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.72rem;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--muted);font-weight:600;
    padding:.7rem 1rem;text-align:left;
    border-bottom:1px solid var(--border);
  }
  .rank-table td{
    padding:.75rem 1rem;
    border-bottom:1px solid rgba(26,56,37,.4);
    font-size:.9rem;color:var(--text);
  }
  .rank-table tr:hover td{background:rgba(0,200,83,.03);}
  .rank-num{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.3rem;color:var(--muted);
    letter-spacing:1px;
  }
  .rank-num.top{color:var(--accent);}
  .rank-flag{font-size:1.1rem;margin-right:.4rem;}
  .player-name-cell{font-weight:600;color:var(--white);}
  .rating-bar-wrap{display:flex;align-items:center;gap:.8rem;}
  .rating-bar{height:4px;background:var(--border);border-radius:2px;flex:1;}
  .rating-fill{height:100%;border-radius:2px;background:linear-gradient(90deg,var(--green),var(--green2));}
  .rating-val{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;color:var(--green);
    min-width:38px;font-size:.95rem;
  }
  .rank-filter{
    display:flex;gap:.5rem;
    margin-bottom:1.2rem;
    flex-wrap:wrap;
  }
  .rf-btn{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.75rem;letter-spacing:1px;text-transform:uppercase;font-weight:600;
    padding:.35rem .85rem;border-radius:20px;
    border:1px solid var(--border);
    background:none;color:var(--muted);cursor:pointer;
    transition:all .2s;
  }
  .rf-btn:hover,.rf-btn.active{
    background:rgba(0,200,83,.1);
    border-color:rgba(0,200,83,.35);
    color:var(--green);
  }

  /* ─── PLAYER RECORDS ─── */
  .player-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.2rem;}
  .player-card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:12px;
    overflow:hidden;
    transition:transform .25s,border-color .25s;
    cursor:pointer;
  }
  .player-card:hover{transform:translateY(-4px);border-color:rgba(0,200,83,.35);}
  .player-header{
    padding:1.2rem 1.4rem;
    background:linear-gradient(135deg,rgba(0,200,83,.08),rgba(0,200,83,.02));
    display:flex;align-items:center;gap:1rem;
    border-bottom:1px solid var(--border);
  }
  .player-avatar{
    width:52px;height:52px;border-radius:50%;
    background:linear-gradient(135deg,var(--green),rgba(0,200,83,.3));
    display:flex;align-items:center;justify-content:center;
    font-family:'Bebas Neue',sans-serif;
    font-size:1.4rem;color:var(--dark);
    flex-shrink:0;
    border:2px solid rgba(0,200,83,.3);
  }
  .player-info{flex:1;}
  .player-info h3{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;font-size:1.1rem;
    color:var(--white);letter-spacing:.5px;
    margin-bottom:.1rem;
  }
  .player-info p{font-size:.75rem;color:var(--muted);}
  .player-role{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.65rem;letter-spacing:1px;text-transform:uppercase;
    background:rgba(0,200,83,.1);border:1px solid rgba(0,200,83,.2);
    color:var(--green);padding:.15rem .5rem;border-radius:3px;font-weight:600;
  }
  .player-role.bowl{background:rgba(255,82,82,.08);border-color:rgba(255,82,82,.2);color:var(--red);}
  .player-role.all{background:rgba(255,202,40,.08);border-color:rgba(255,202,40,.2);color:var(--accent);}
  .player-stats{
    display:grid;grid-template-columns:repeat(3,1fr);
    padding:1rem 1.4rem;gap:.8rem;
  }
  .pstat{text-align:center;}
  .pstat-val{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.6rem;color:var(--white);
    letter-spacing:1px;
  }
  .pstat-lbl{font-size:.65rem;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;}
  .player-footer{
    padding:.8rem 1.4rem;
    border-top:1px solid var(--border);
    display:flex;gap:1.5rem;
    font-size:.78rem;color:var(--muted);
  }
  .player-footer span{display:flex;align-items:center;gap:.3rem;}

  /* ─── MATCH ANALYSIS ─── */
  .analysis-hero{
    background:linear-gradient(135deg,rgba(0,200,83,.08),rgba(0,200,83,.02));
    border:1px solid var(--border);
    border-radius:12px;
    padding:1.8rem;
    margin-bottom:1.2rem;
    display:grid;
    grid-template-columns:1fr auto;
    gap:2rem;align-items:center;
  }
  .win-prob{display:flex;flex-direction:column;gap:.8rem;}
  .win-prob-label{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.72rem;letter-spacing:2px;text-transform:uppercase;
    color:var(--muted);font-weight:600;
  }
  .prob-bar{
    height:12px;border-radius:6px;
    background:var(--border);
    overflow:hidden;display:flex;
  }
  .prob-fill-a{
    background:linear-gradient(90deg,#1565c0,#42a5f5);
    transition:width 1s ease;
  }
  .prob-fill-b{
    background:linear-gradient(90deg,#e65100,#ff7043);
    transition:width 1s ease;
  }
  .prob-labels{display:flex;justify-content:space-between;font-size:.8rem;}
  .prob-a{color:#64b5f6;font-weight:600;}
  .prob-b{color:#ff7043;font-weight:600;}
  .worm-chart{width:260px;height:140px;}
  .chart-svg line,.chart-svg path{stroke-width:2;}
  .chart-label{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.72rem;letter-spacing:2px;text-transform:uppercase;
    color:var(--muted);font-weight:600;
    margin-bottom:.6rem;
  }
  .phase-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;}
  .phase-card{
    background:var(--card);border:1px solid var(--border);
    border-radius:10px;padding:1.2rem;text-align:center;
  }
  .phase-name{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.7rem;letter-spacing:1.5px;text-transform:uppercase;
    color:var(--muted);font-weight:600;margin-bottom:.5rem;
  }
  .phase-score{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.8rem;color:var(--white);letter-spacing:1px;
  }
  .phase-rr{font-size:.8rem;color:var(--green);}
  .bowler-perf{margin-top:1.2rem;}
  .bp-row{
    display:flex;align-items:center;gap:1rem;
    padding:.6rem 0;border-bottom:1px solid rgba(26,56,37,.4);
  }
  .bp-name{flex:1;font-size:.88rem;color:var(--text);}
  .bp-fig{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;font-size:1rem;color:var(--accent);
  }
  .bp-econ{font-size:.8rem;color:var(--muted);min-width:40px;text-align:right;}
  .bp-bar{width:80px;height:4px;background:var(--border);border-radius:2px;}
  .bp-fill{height:100%;border-radius:2px;background:var(--red);}
  .partnership-list{display:flex;flex-direction:column;gap:.7rem;}
  .partnership{
    display:flex;align-items:center;gap:.8rem;
    font-size:.85rem;
  }
  .p-batters{color:var(--text);flex:1;}
  .p-runs{
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;font-size:1rem;color:var(--green);
    min-width:50px;text-align:right;
  }
  .p-bar-wrap{width:120px;height:5px;background:var(--border);border-radius:3px;}
  .p-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--green),var(--green2));}

  /* ─── SEARCH BAR ─── */
  .search-wrap{
    display:flex;gap:.8rem;margin-bottom:1.5rem;
    align-items:center;
  }
  .search-input{
    flex:1;max-width:360px;
    background:var(--card);
    border:1px solid var(--border);
    border-radius:8px;
    padding:.7rem 1.1rem;
    font-family:'Barlow',sans-serif;
    font-size:.9rem;
    color:var(--text);
    outline:none;
    transition:border-color .2s;
  }
  .search-input::placeholder{color:var(--muted);}
  .search-input:focus{border-color:rgba(0,200,83,.4);}

  /* ─── TICKER ─── */
  .ticker-wrap{
    background:rgba(0,200,83,.06);
    border-bottom:1px solid rgba(0,200,83,.15);
    overflow:hidden;
    height:36px;
    display:flex;align-items:center;
  }
  .ticker-label{
    font-family:'Barlow Condensed',sans-serif;
    font-size:.72rem;letter-spacing:2px;text-transform:uppercase;
    color:var(--green);font-weight:700;
    padding:0 1.2rem;
    background:rgba(0,200,83,.1);
    height:100%;display:flex;align-items:center;
    border-right:1px solid rgba(0,200,83,.2);
    flex-shrink:0;white-space:nowrap;
  }
  .ticker-track{display:flex;animation:ticker 45s linear infinite;will-change:transform;}
  .ticker-item{
    white-space:nowrap;
    font-family:'Barlow Condensed',sans-serif;
    font-size:.82rem;color:var(--text);
    padding:0 2.5rem;
  }
  .ticker-item .t-score{color:var(--green);font-weight:700;}
